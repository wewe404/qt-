/* 参考 Windows 计算器的浅色主题 */

* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif;
}

QMainWindow,
#centralwidget {
    background-color: #f2f2f2;
}

QLineEdit#display {
    background-color: #f2f2f2;
    border: none;
    border-bottom: 1px solid #e4e4e4;
    color: #1c1c1c;
    font-size: 40px;
    padding: 0px 12px;
    min-height: 86px;
    max-height: 86px;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #e4e4e4;
    border-radius: 2px;
    color: #1c1c1c;
    font-size: 20px;
    min-height: 56px;
}

QPushButton:hover {
    background-color: #f7f7f7;
}

QPushButton:pressed {
    background-color: #ebebeb;
}

/* 顶行功能键：% CE C ⌫ */
QPushButton#percentButton,
QPushButton#clearEntryButton,
QPushButton#clearButton,
QPushButton#backspaceButton {
    font-size: 17px;
}

/* 一元函数键：1/x x² √x */
QPushButton#reciprocalButton,
QPushButton#squareButton,
QPushButton#squareRootButton {
    font-size: 16px;
}

/* 运算符列：÷ × − + */
QPushButton#addButton,
QPushButton#subtractButton,
QPushButton#multiplyButton,
QPushButton#divideButton {
    font-size: 24px;
}

/* 正负号键 */
QPushButton#signButton {
    font-size: 17px;
}

/* 等号键：浅蓝色高亮 */
QPushButton#equalsButton {
    background-color: #7eb3d8;
    border: 1px solid #6ea6cf;
    color: #ffffff;
    font-size: 26px;
    font-weight: 600;
}

QPushButton#equalsButton:hover {
    background-color: #8fbee0;
}

QPushButton#equalsButton:pressed {
    background-color: #6ba4cc;
}
